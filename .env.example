# MURAT/LAB — environment variables (FAZ 3A). Copy to .env.local for local development. NEVER commit real values.
#
# Hepsi OPSİYONELDİR: tanımlı değilse herkese açık site dosya tabanlı içerikle aynen çalışır,
# yalnızca /admin kapalı kalır (production'da 404). typecheck / lint / build bu değişkenler olmadan geçer.

# --- Tarayıcıya açılmak üzere TASARLANMIŞ (güvenlik RLS'ten gelir) ---------------------------------
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) anahtar. Eski ad NEXT_PUBLIC_SUPABASE_ANON_KEY de kabul edilir.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- ASLA NEXT_PUBLIC_ öneki alamaz, ASLA tarayıcıya / bu uygulamaya girmez ------------------------
# SUPABASE_SERVICE_ROLE_KEY: FAZ 3A'da uygulama kodu bunu OKUMAZ. Yalnızca (isteğe bağlı) yerel araçlar için,
# ör. tek seferlik içerik geçişi. Vercel ortam değişkenlerine eklenmez.
# SUPABASE_SERVICE_ROLE_KEY=
